{
  "name": "sabaki",
  "version": "1.11.1",
  "license": "MIT",
  "description": "Sabaki — routeur léger vers des plugins de décision typée (zéro dépendance runtime).",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "prepack": "npm run build",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "example": "ts-node --esm examples/example.ts",
    "format": "bunx --bun @biomejs/biome format --write ./src",
    "check": "bunx --bun @biomejs/biome check ./src",
    "lint": "bunx --bun @biomejs/biome lint ./src",
    "lint:write": "bunx --bun @biomejs/biome lint --write ./src",
    "test": "bun test ./tests",
    "build": "tsc --project tsconfig.json && cp src/default-keywords.json src/langid-weights.json dist/",
    "deploy:npm": "npm publish --access public",
    "publish-package": "bash ./scripts/publish-package.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.12",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "tsup": "^9.0.0",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "keywords": [
    "decision",
    "classification",
    "router",
    "typed-decisions",
    "plugins"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sabaki-js/sabaki"
  },
  "author": "fox3000foxy",
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.22.0",
    "@sabaki-js/customer-service": "^1.0.0",
    "@sabaki-js/invoice-processing": "^1.0.0",
    "@sabaki-js/security-incidents": "^1.0.0",
    "@sabaki-js/agent-trace-observability": "^1.0.0",
    "@sabaki-js/mail": "^1.0.0",
    "@sabaki-js/doom": "^1.0.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0"
  },
  "bin": {
    "bunkitsu": "bin/bunkitsu.mjs"
  }
}